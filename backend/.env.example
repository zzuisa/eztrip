# Copy to .env and fill in. Keys left empty switch the related feature off.

APP_NAME=EZTrip
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8881
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# LLM (any OpenAI-compatible endpoint, e.g. a LiteLLM proxy or Ollama)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_CONTENT=
LLM_MODEL_TOOL=
LLM_MAX_TOKENS=8192
LLM_DISABLE_THINKING=false
LLM_LEAN_PROMPTS=false
LLM_AGENT_MODEL_FAST=
LLM_AGENT_MODEL_REASONING=
LLM_AGENT_MODEL_TOOL=
PLANNING_MODE=agent

# Fallback provider used when LLM_* is empty
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL_DEEPSEEK_V32=deepseek-ai/DeepSeek-V3.2
LLM_MODEL_DEEPSEEK_R1=deepseek-ai/DeepSeek-R1
LLM_ALLOW_R1=false

# Maps and places
MAP_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
AMAP_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
GOOGLE_PLACES_TIMEOUT_SECONDS=30
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# Deutsche Bahn (optional)
ENABLE_DB_FEATURE=false
DB_API_BASE_URL=https://v6.db.transport.rest
DB_API_KEY=
DB_CLIENT_ID=
DB_CLIENT_SECRET=
DB_TIMEOUT_SECONDS=20
DB_USE_BEARER_AUTH=false
ENABLE_DB_MCP=false
DB_MCP_SSE_URL=
DB_MCP_SERVER=db_timetable

# Xiaohongshu tips via MCP (optional)
ENABLE_XIAOHONGSHU_MCP=false
XIAOHONGSHU_MCP_BASE_URL=
XIAOHONGSHU_MCP_API_KEY=
XIAOHONGSHU_MCP_SERVER=xiaohongshu
XIAOHONGSHU_MCP_TIMEOUT_SECONDS=90

DEBUG_MAPBOX=false
DEBUG_DB=false
DEBUG_XIAOHONGSHU=false
DEBUG_TRIP_MAP_ONLY=false
DEBUG_ATTRACTION_MAP=false
DEBUG_GOOGLE_PLACES_FULL_KEY=false
